<?xml version="1.0" encoding="utf-8"?>
<!-- Workout widget: list mode (today's exercises) and card mode (one exercise with its animation). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layoutDirection="ltr"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_list_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.14"
                android:text="GYM DAY"
                android:textColor="#E3C98F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F1ECF7"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/w_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#E3C98F"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_card_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c_back"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/w_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="‹  Back"
                android:textColor="#F1ECF7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/c_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A39BB3"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="#07060A">

            <ViewFlipper
                android:id="@+id/c_anim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="130" />

            <TextView
                android:id="@+id/c_noanim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#A39BB3"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/c_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F1ECF7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/c_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C9B4FF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/c_weight_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c_minus"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/w_pill"
                android:gravity="center"
                android:text="−"
                android:textColor="#F1ECF7"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F1ECF7"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/c_weight_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7D748F"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/c_plus"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/w_pill_accent"
                android:gravity="center"
                android:text="+"
                android:textColor="#120A22"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/c_cues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="#A39BB3"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c_switch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/w_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⇄ Switch"
                android:textColor="#C9B4FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/c_done"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/w_pill_accent"
                android:gravity="center"
                android:textColor="#120A22"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
